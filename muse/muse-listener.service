[Unit]
Description=Muse BotConnect listener (Satu Digital)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@MUSE_DIR@
EnvironmentFile=/home/hatch/.config/muse-listener.env
ExecStart=/usr/bin/python3 @MUSE_DIR@/muse.py
Restart=on-failure
RestartSec=5
StandardOutput=append:@MUSE_DIR@/muse-listener.out
StandardError=inherit

[Install]
WantedBy=multi-user.target
